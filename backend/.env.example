# --- Database ---
DATABASE_URL=postgresql+asyncpg://qems:qems@localhost:5432/qems

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- OpenAI (replaces Gemini from the original report) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

MAX_UPLOAD_SIZE_MB=15

# --- Rate limiting ---
LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- Object storage (MinIO locally; swap for real S3/Supabase Storage/Azure Blob in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=qems_minio
S3_SECRET_KEY=qems_minio_secret
S3_BUCKET=qems-evidence
S3_REGION=us-east-1

# --- Email (Mailpit locally, catches everything at http://localhost:8025; swap for
#     SendGrid/Resend/real SMTP in prod) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=qems@qemscorp.dev
