# --- Database (Supabase Postgres) ---
# From Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the Direct connection (or Session pooler as an IPv4 fallback) -- NOT the
# Transaction pooler (port 6543), which doesn't support the prepared statements
# asyncpg/SQLAlchemy use by default. Prefix with postgresql+asyncpg:// (not the
# postgresql:// Supabase gives you) and keep ?ssl=require -- Supabase requires SSL.
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?ssl=require

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- OpenAI (replaces Gemini from the original report) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

MAX_UPLOAD_SIZE_MB=15

# --- Rate limiting ---
LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- Object storage (Supabase Storage, S3-compatible) ---
# From Supabase: Project Settings -> Storage -> S3 Connection -> "New access key".
# storage_service.py talks to any S3-compatible endpoint unchanged -- this is a config
# swap, not a code change.
S3_ENDPOINT_URL=https://[YOUR-PROJECT-REF].storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY=[YOUR-S3-ACCESS-KEY-ID]
S3_SECRET_KEY=[YOUR-S3-SECRET-ACCESS-KEY]
S3_BUCKET=qems-evidence
S3_REGION=[YOUR-PROJECT-REGION]

# --- Email (Mailpit locally, catches everything at http://localhost:8025; swap for
#     SendGrid/Resend/real SMTP in prod) ---
# This is also the fallback used whenever the Gmail OAuth block below is left empty --
# Gmail is never required for QEMS notifications to work.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=qems@qemscorp.dev

# --- Gmail OAuth (optional -- see backend/README.md "Gmail notification setup") ---
# Leave all four blank to use the SMTP settings above instead. Once set, GmailProvider
# is used for outbound send AND polled for inbound stakeholder replies.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8765/
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=you@yourdomain.com

# Base URL used to build the "View Error" link inside every notification email.
APP_BASE_URL=http://localhost:5173
NOTIFICATION_MAX_RETRIES=3
